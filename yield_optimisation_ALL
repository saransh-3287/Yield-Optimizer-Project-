def SC(x, c, d, r0, r1, r2, s0, s1, s2, kink):

    u = c / (d + x)  

    # multi-function below
    if u <= kink:
        r_b = r0 + r1 * u
    else:
        r_b = r0 + r1 * kink + r2 * (u - kink)

    if u <= kink:
        r_s = s0 + s1 * u
    else:
        r_s = s0 + s1 * kink + s2 * (u - kink)

    return u, r_b, r_s



